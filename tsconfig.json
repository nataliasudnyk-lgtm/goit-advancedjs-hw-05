
{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "ES2019",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2021"],
    "strict": true,
    "strictNullChecks": true,
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
